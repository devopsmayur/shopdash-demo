{
  "env": { "browser": true, "es2021": true },
  "extends": ["eslint:recommended", "plugin:react/recommended"],
  "parserOptions": { "ecmaVersion": 12, "sourceType": "module" },
  "rules": {
    "no-unused-vars": "warn",
    "eqeqeq": "off",
    "no-console": "off",
    "react/prop-types": "off"
  }
}